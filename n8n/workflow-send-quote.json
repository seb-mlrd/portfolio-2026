            {
              "id": "1",
              "leftValue": "={{ $('Webhook').first().json.body.event }}",
              "rightValue": "quote.send",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            },
            {
              "id": "2",
              "leftValue": "={{ Math.abs(Date.now() - Number($('Webhook').first().json.body.timestamp)) < 300000 }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ]
        },
        "options": {}
      }

    {
      "parameters": {
        "jsCode": "const config = $('Config').first().json;\nconst devis = $('Réception de la demande').first().json.body.quote;\nconst esc = (s) => String(s ?? '').replace(/[&<>\"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '\"': '&quot;', \"'\": '&#39;' })[c]);\nconst montant = new Intl.NumberFormat('fr-FR', { style: 'currency', currency: 'EUR' }).format(devis.totalCents / 100);\nconst validite = new Intl.DateTimeFormat('fr-FR', { dateStyle: 'long', timeZone: 'UTC' }).format(new Date(devis.validUntil));\nconst nom = devis.client.contactName;\nconst salutation = nom ? 'Bonjour ' + esc(nom) + ',' : 'Bonjour,';\nconst bouton = '<p style=\"margin:28px 0\"><a href=\"' + esc(devis.publicUrl) + '\" style=\"background:#1f2937;color:#ffffff;padding:12px 22px;border-radius:4px;text-decoration:none\">Consulter et accepter le devis</a></p>';\nconst signature = '<p>Cordialement,<br>' + esc(config.nomExpediteur) + (devis.issuer.phone ? '<br>' + esc(devis.issuer.phone) : '') + '</p>';\nconst page = (corps) => '<div style=\"font-family:Arial,sans-serif;font-size:15px;line-height:1.6;color:#1f2937;max-width:560px\"><p>' + salutation + '</p>' + corps + bouton + signature + '</div>';\nconst suffixe = devis.vatEnabled ? ' TTC' : '';\n\nreturn [{\n  json: {\n    destinataire: config.modeTest ? config.emailTest : devis.client.email,\n    objet: 'Devis ' + devis.number + ' – ' + config.nomExpediteur,\n    html: page('<p>Veuillez trouver ci-joint votre devis :</p><ul><li>Numéro : <strong>' + esc(devis.number) + '</strong></li><li>Montant total : <strong>' + montant + suffixe + '</strong></li><li>Valable jusqu’au : <strong>' + validite + '</strong></li></ul><p>Vous pouvez le consulter et l’accepter en ligne :</p>'),\n    relance1: page('<p>Je me permets de revenir vers vous au sujet du devis ' + esc(devis.number) + '. Avez-vous pu en prendre connaissance ? Je reste à votre disposition pour toute question.</p>'),\n    relance2: page('<p>Sauf erreur de ma part, je n’ai pas eu de retour sur le devis ' + esc(devis.number) + ', valable jusqu’au ' + validite + '. Souhaitez-vous que nous en discutions ?</p>'),\n    pdfUrl: $json.pdfUrl,\n  },\n  binary: $('Générer le PDF').first().binary,\n}];"
      },

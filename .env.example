# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/portfolio_dev"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-with: openssl rand -base64 32"

# Admin credentials (for seeding)
ADMIN_EMAIL="admin@portfolio.local"
ADMIN_PASSWORD="change-me"

# ─── Devis ───
# URL publique du site (liens envoyés aux clients)
APP_PUBLIC_URL="http://localhost:3000"
# URL du site vue depuis Gotenberg et n8n (en local : Docker → hôte)
APP_INTERNAL_URL="http://host.docker.internal:3000"
# Signe les liens d'impression temporaires : openssl rand -hex 32
QUOTE_PRINT_SECRET=""
# Webhooks n8n (URL de production, /webhook/ et non /webhook-test/)
N8N_WEBHOOK_SEND_QUOTE_URL="http://localhost:5678/webhook/send-quote"
N8N_WEBHOOK_QUOTE_ACCEPTED_URL="http://localhost:5678/webhook/quote-accepted"
# Secret HMAC des webhooks, identique dans n8n : openssl rand -hex 32
N8N_WEBHOOK_SECRET=""
# Clé présentée par n8n à l'app (Authorization: Bearer …) : openssl rand -hex 32
N8N_API_KEY=""
# En-tête d'IP posé (et écrasé) par le reverse proxy
CLIENT_IP_HEADER="x-real-ip"
# Base dédiée aux tests de numérotation (facultatif : tests ignorés sinon). Son nom doit finir par _test
TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/portfolio_test"
